# Copy to .env and fill only the providers used for live runs.
GOOGLE_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Scenario input for live runs (set this to an existing JSON file).
# TEST_CASES_PATH=/path/to/test_cases.json

# Optional output directory; the default is outputs/raw_runs/.
# RESULTS_DIR=/path/to/raw_runs
